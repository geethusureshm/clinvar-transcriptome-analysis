)]

head(final_meta)
head(final_meta)
library(dplyr)

final_meta <- final_meta %>%
  filter(!is.na(`Gene Symbol`)) %>%        # remove NA
  filter(`Gene Symbol` != "None")          # remove fake rows

head(final_meta)
unique(final_meta$`Gene Symbol`)
final_meta <- merge(final_meta,
                    final_table,
                    by.x = "Gene Symbol",
                    by.y = "Gene",
                    all.x = TRUE)
final_meta$Regulation <- ifelse(final_meta$logFC > 0,
                               "Upregulated",
                               "Downregulated")
final_meta$Category <- NA

final_meta$Category[grepl("immune|cytokine|inflammatory", final_meta$`Biological Process (GO)`, ignore.case = TRUE)] <- "Immune response"

final_meta$Category[grepl("signal|kinase|phospho", final_meta$`Biological Process (GO)`, ignore.case = TRUE)] <- "Signal transduction"

final_meta$Category[grepl("stress|autophagy|response", final_meta$`Biological Process (GO)`, ignore.case = TRUE)] <- "Stress response"

final_meta$Category[grepl("cell cycle", final_meta$`Biological Process (GO)`, ignore.case = TRUE)] <- "Cell cycle"
final_clean <- final_meta[, c(
  "Gene Symbol",
  "logFC",
  "adj.P.Val",
  "Regulation",
  "Category",
  "Biological Process (GO)",
  "Protein Functions",
  "Disease & Drugs"
)]

